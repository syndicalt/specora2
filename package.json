{
  "name": "specora",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:stable": "bash scripts/dev-stable.sh",
    "dev:https": "pnpm certs:localhost && turbo run dev:https --filter @specora/api --filter @specora/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "proto:generate": "bash packages/protobuf/generate.sh",
    "migrate": "pnpm --filter @specora/db migrate",
    "migrate:status": "pnpm --filter @specora/db migrate:status",
    "migrate:dry-run": "pnpm --filter @specora/db migrate:dry-run",
    "migrate:baseline": "pnpm --filter @specora/db migrate:baseline",
    "validate:seed": "bash scripts/validate-seed.sh",
    "demo:ready": "bash scripts/demo-readiness.sh",
    "restore:rehearsal": "bash scripts/restore-rehearsal.sh",
    "release:check": "bash scripts/release-check.sh",
    "prod:ready": "RELEASE_CHECK_MODE=full bash scripts/release-check.sh",
    "certs:localhost": "bash scripts/generate-localhost-certs.sh"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^1.13.4"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=20"
  }
}
